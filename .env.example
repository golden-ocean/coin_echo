# =============================================================
# coin_echo 环境变量示例
# 用法：cp .env.example .env（.env 已被 .gitignore 排除，不会入库）
#
# 命名规则（与 platform-config 的 figment 加载对应）：
#   - 每个配置结构体有自己的前缀：SERVER_ / DATABASE_ / REDIS_ /
#     JWT_ / PASSWORD_ / CASBIN_ / TELEMETRY_ / MIDDLEWARE_
#   - 嵌套结构体的层级用「双下划线 __」连接！
#     例如 cors.allowed_origins 对应的变量是：
#       MIDDLEWARE_CORS__ALLOWED_ORIGINS
#     （写成单下划线 MIDDLEWARE_CORS_ALLOWED_ORIGINS 是读不到的）
#   - 布尔值一律小写 true / false
#   - 未填写的项使用代码内置默认值；标注【必填】的缺失会导致启动失败
#   - 注意：.env 不会覆盖 shell 中已 export 的同名变量
# =============================================================


# -------------------------------------------------------------
# HTTP 服务器（apps/server，前缀 SERVER_）
# -------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# 请求读取超时（秒），不能为 0
SERVER_READ_TIMEOUT_SECS=60
# 优雅关闭等待时长（秒），范围 1~120
SERVER_SHUTDOWN_GRACE_SECS=10


# -------------------------------------------------------------
# PostgreSQL（platform-database，前缀 DATABASE_）
# -------------------------------------------------------------
# 【必填】主库（读写）连接串
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coin_echo
# 只读副本连接串，留空则读写都走 DATABASE_URL
DATABASE_REPLICA_URL=
# 连接池参数（均有默认值）
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_ACQUIRE_TIMEOUT_SECS=10
DATABASE_MAX_LIFETIME_SECS=1800
DATABASE_IDLE_TIMEOUT_SECS=600


# -------------------------------------------------------------
# Redis 缓存（platform-cache，前缀 REDIS_）
# -------------------------------------------------------------
# 【必填】连接串
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_SIZE=16
REDIS_TIMEOUT_SECS=5


# -------------------------------------------------------------
# JWT（platform-security，前缀 JWT_）
# -------------------------------------------------------------
# 【必填】access token 密钥，至少 32 字节
JWT_ACCESS_SECRET=change-me-access-secret-0123456789abcdef
# access token 有效期（分钟）
JWT_ACCESS_EXPIRE_MINUTES=15
# 【必填】refresh token 密钥，至少 32 字节，且必须与 access 密钥不同
JWT_REFRESH_SECRET=change-me-refresh-secret-0123456789abcdef
# refresh token 有效期（小时），默认 720（30 天）
JWT_REFRESH_EXPIRE_HOURS=720
# 签发者 iss 声明
JWT_ISSUER=app


# -------------------------------------------------------------
# 密码哈希 Argon2id（platform-security，前缀 PASSWORD_）
# -------------------------------------------------------------
# 均为 OWASP 基线默认值，低于基线会校验失败拒绝启动
PASSWORD_MEMORY_KIB=19456
PASSWORD_ITERATIONS=2
PASSWORD_PARALLELISM=1


# -------------------------------------------------------------
# Casbin 权限（platform-security，前缀 CASBIN_）
# 注意：infra.rs 中 Casbin 目前被注释掉，尚未启用；启用后以下两项必填
# -------------------------------------------------------------
# CASBIN_MODEL_PATH=config/rbac_model.conf
# CASBIN_POLICY_PATH=config/policy.csv


# -------------------------------------------------------------
# 遥测（platform-telemetry，前缀 TELEMETRY_）
# -------------------------------------------------------------
# 日志级别：trace / debug / info / warn / error
TELEMETRY_LEVEL=info
# 日志格式：pretty（开发）/ json（生产）
TELEMETRY_FORMAT=pretty
# 是否输出 ANSI 颜色码（仅 pretty 生效）
TELEMETRY_ANSI=true
# 追加的按模块过滤指令，逗号分隔，如 sqlx=warn,tower_http=info
TELEMETRY_EXTRA_DIRECTIVES=
# 服务名称（日志字段 / 未来的 OTel service.name）
TELEMETRY_SERVICE_NAME=app
# OTel 追踪开关（当前未实现，开启仅打 warn 日志）
TELEMETRY_OTEL_ENABLED=false
# OTLP collector 地址（仅 otel_enabled=true 时需要）
TELEMETRY_OTLP_ENDPOINT=
# 采样比例 0.0~1.0
TELEMETRY_SAMPLE_RATIO=1.0


# -------------------------------------------------------------
# 全局中间件（platform-middleware，前缀 MIDDLEWARE_）
# 中间件配置加载失败不会阻止启动，会落回默认值
# -------------------------------------------------------------
MIDDLEWARE_REQUEST_ID_ENABLED=true
MIDDLEWARE_TRACE_ENABLED=true
MIDDLEWARE_CATCH_PANIC_ENABLED=true
MIDDLEWARE_COMPRESSION_ENABLED=true
MIDDLEWARE_CORS_ENABLED=true
MIDDLEWARE_SECURITY_HEADERS_ENABLED=true
MIDDLEWARE_RATE_LIMIT_ENABLED=true
# 单个请求最长处理时间（秒）
MIDDLEWARE_TIMEOUT_SECS=30
# 请求体大小上限（字节），默认 2097152 = 2 MiB
MIDDLEWARE_BODY_LIMIT_BYTES=2097152

# 【嵌套字段，注意用双下划线 __】CORS 白名单，逗号分隔；
# 留空 = 拒绝所有跨域请求（会打 warn 日志）
MIDDLEWARE_CORS__ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# 限流参数（同样双下划线）：
# 每个 IP 每个窗口内允许的最大请求数
MIDDLEWARE_RATE_LIMIT__MAX_REQUESTS=100
# 窗口长度（秒）
MIDDLEWARE_RATE_LIMIT__WINDOW_SECS=1
# ⚠️ 冗余字段：rate_limit.enabled 目前没有任何代码读取（layer 只读
# max_requests/window_secs），开关请用上面的 MIDDLEWARE_RATE_LIMIT_ENABLED。
# 建议后续删除该字段；这里保留注释以备完整参考：
# MIDDLEWARE_RATE_LIMIT__ENABLED=true
